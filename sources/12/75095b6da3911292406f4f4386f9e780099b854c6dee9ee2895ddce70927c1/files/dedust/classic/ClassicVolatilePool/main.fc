            reserve1 -= received;
            fees0 += protocol_fee;
        }
        else {
            reserve1 += amount - protocol_fee;
            reserve0 -= received;
            fees1 += protocol_fee;
        }
        reserves = opaque_tuple(pair(reserve0,reserve1));
        protocol_fees = opaque_tuple(pair(fees0,fees1));
