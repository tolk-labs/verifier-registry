    }
    catch(value,code) {
        replace_actions(empty_actions());
        (cell callback,code,int valid) = exception_callback(value,code);
        ifnot(valid) {
            callback = null();
        }
        int refund = message_value - get_gas_fee(gas_consumed() + 4314,0);
        send_inline(0,payout_body(query,pool_descriptor,amount,owner,evaluated_callback(callback)),refund,vault_address(asset));
