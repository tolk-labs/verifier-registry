(int, int, int, int) calculate_liquidity (int supply, int reserve0, int reserve1, int amount0, int amount1) impure inline_ref {
    int minted = 0;
    if (supply == 0) {
        supply = 1000;
        minted = max(99000, max(amount0, amount1));
    }
    else {
        int used0 = min(amount0, muldiv(amount1, reserve0, reserve1));
        int used1 = min(amount1, muldiv(amount0, reserve1, reserve0));
        minted = min(muldiv(supply, used0, reserve0), muldiv(supply, used1, reserve1));
        amount0 = used0;
        amount1 = used1;
    }
    return (amount0, amount1, minted, supply);
}
