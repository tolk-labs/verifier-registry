() deploy_pool(int query,int stable,slice asset0,int precision0,slice asset1,int precision1,int fee) impure method_id(136) {
 tuple params = opaque_tuple(triple(stable,asset0,asset1));
 (params,int swapped) = sort_assets(params);
 if (swapped) { (precision0,precision1) = (precision1,precision0); }
 cell state = pool_state(params);
 (int version,cell code) = unpack_pair(pool_implementation);
 send_pool_deploy(state,64,install_body(query,blank_code,version,code,begin_cell().store_version(fee).store_ref(lp_wallet_code).store_uint(precision0,8).store_uint(precision1,8)));
}

