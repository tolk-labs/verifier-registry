() handle_create_vault (int value, slice body) impure method_id(142) {
    load_factory();
    throw_unless(263, (value >= 100000000));
    (slice s2_00, int query) = body.skip_bits(32)
        .read_query_id();
    (slice result_00, slice asset) = read_asset(s2_00);
    result_00.end_parse();
    deploy_vault(asset, query, evaluated_slice(EMPTY_SLICE));
    return ();
}

() recv_internal (int message_value, cell message_full, slice message_body) impure method_id(0) {
    (slice s2_00, int x_00) = message_full.begin_parse()
        .load_uint(4);
    (_, slice s2_01) = s2_00.load_msg_addr();
    x_00 = remember_sender(x_00,s2_01);
    throw_if(0, ((x_00 & 1) | message_body.slice_empty?()));
    int x_01 = message_body.preload_uint(32);
    if (x_01 == 3395376462) {
        handle_transfer_ownership(message_body);
        return ();
    }
    if (x_01 == 3739616260) {
        handle_accept_ownership();
        return ();
    }
    if (x_01 == 382435266) {
        handle_cancel_ownership();
        return ();
    }
    if (x_01 == 3158255350) {
        handle_install_vault_code(message_body);
        return ();
    }
    if (x_01 == 567271467) {
        handle_create_vault(message_value, message_body);
        return ();
    }
    if (x_01 == 3383063853) {
        handle_create_legacy_jetton_vault(message_value, message_body);
        return ();
    }
    if (x_01 == 634808593) {
        handle_upgrade_vault(message_body);
        return ();
    }
    if (x_01 == 2320600333) {
        handle_reset_vault_gas(message_body);
        return ();
    }
    if (x_01 == 3746178986) {
        handle_upgrade_factory(message_body);
        return ();
    }
    if (x_01 == 2671708471) {
        handle_reset_factory_gas();
        return ();
    }
    if (x_01 == 3117586839) {
        handle_deploy_operator(message_value, message_body);
        return ();
    }
    if (x_01 == 468115347) {
        handle_change_operator_user(message_value, message_body);
        return ();
    }
    if (x_01 == 3842363930) {
        handle_install_operator_code(message_body);
        return ();
    }
    if (x_01 == 8779171) {
        handle_upgrade_operator(message_value, message_body);
        return ();
    }
    if (x_01 == 2749652465) {
        handle_install_pool_code(message_body);
        return ();
    }
    if (x_01 == 2547326767) {
        handle_create_volatile_pool(message_value, message_body);
        return ();
    }
    if (x_01 == 2084613255) {
        handle_create_stable_pool(message_value, message_body);
        return ();
    }
    if (x_01 == 1407341230) {
        handle_upgrade_pool(message_value, message_body);
        return ();
    }
    if (x_01 == 2577941265) {
        handle_install_deposit_code(message_body);
        return ();
    }
    if (x_01 == 4031694118) {
        handle_fund_deposit(message_value, message_body);
        return ();
    }
    throw(65535);
}

() handle_create_legacy_jetton_vault (int value, slice body) impure method_id(143) {
    load_factory();
    verify_operator(6);
    throw_unless(263, (value >= 100000000));
    (slice s2_00, int query) = body.skip_bits(32)
        .read_query_id();
    (slice s3_00, slice master) = s2_00.load_msg_addr();
    (slice s3_01, slice resolver) = s3_00.load_msg_addr();
    s3_01.end_parse();
    (int workchain, int account_hash) = master.parse_std_addr();
    deploy_vault(jetton_asset(workchain,account_hash), query, resolver);
    return ();
}

() handle_upgrade_vault(slice body) impure method_id(144) {
 load_factory(); verify_operator(2); body = body.skip_bits(32); int query = body~read_query_id(); (body,slice asset) = read_asset(body); body.end_parse();
 int tag = evaluated(asset.preload_uint(4));
 (int version,cell code,int found) = lookup_vault_code(vault_codes,tag); throw_unless(260,found);
 (int mode,int amount,cell reply,asset) = vault_send_args(64,asset,upgrade_body(query,version,code),0);
 send_vault_ref(mode,amount,reply,asset);
}

() handle_reset_vault_gas(slice body) impure method_id(145) {
 load_factory(); throw_unless(256,equal_slice_bits(message_sender,at(ownership,0)));
 body = body.skip_bits(32); int query = body~read_query_id(); (body,slice asset) = read_asset(body); body.end_parse();
 (int mode,int amount,builder reply,asset) = vault_send_args(64,asset,drain_body(query),0);
 send_vault_inline(mode,amount,reply,asset);
}

() handle_upgrade_factory (slice body) impure method_id(146) {
    load_factory();
    throw_unless(256, equal_slice_bits(message_sender, at(ownership, 0)));
    (int query,int version,cell code) = upgrade_fields(body);
    throw_unless(275, (version == (contract_version + 1)));
    set_code(code);
    contract_version = version;
    save_factory();
    set_c3(bless(code.begin_parse()));
    invoke_installed_hook(43092);
    return ();
}

