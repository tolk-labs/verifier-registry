(int,cell,int) lookup_vault_code(cell codes,int tag) impure inline_ref {
 (slice entry,int found) = udict_get?(codes,4,tag);
 int version = null(); cell code = null(); int present = 0;
 if (found) { version = entry.preload_uint(16); code = entry.preload_ref(); present = -1; }
 else { version = null(); code = null(); present = 0; }
 return (version,code,present);
}

cell install_vault_code (cell codes, int tag, int version, cell code) impure inline_ref {
    (slice entry, int found) = udict_get?(codes, 4, tag);
    int previous = 0;
 if found { previous = entry.preload_uint(16); }
 else { previous = 0; }
    throw_unless(275, (version == (previous + 1)));
    return (udict_set_builder(codes, 4, tag, versioned_code(version,code)));
}

(slice,slice) read_asset(slice cursor) impure inline {
 int tag = cursor.preload_uint(4); slice asset = null();
 if (tag == 0) { (cursor,asset) = read_native_asset(cursor); }
 else {
  if (tag == 1) { slice jetton = cursor~load_bits(268); return (cursor,jetton); }
  invalid_asset(); cursor = null(); asset = null();
 }
 return (cursor,asset);
}

