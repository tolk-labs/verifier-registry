    (slice s2_04, cell parameters) = result_02.load_ref();
    (slice s2_05, int target0) = parameters.begin_parse()
        .load_grams();
    (slice s2_06, int target1) = s2_05.load_grams();
    (slice result_04, slice funded_asset) = read_asset(s2_06);
    (slice s2_07, int funded_amount) = result_04.load_grams();
    (slice s2_08, int minimum) = s2_07.load_grams();
    s2_08.end_parse();
    (slice s2_09, cell success) = s2_04.load_dict();
    (slice s2_0a, cell failure) = s2_09.load_dict();
    s2_0a.end_parse();
    return (query, descriptor, owner, pool_assets, minimum, target0, target1, funded_asset, funded_amount, success, failure);
}

