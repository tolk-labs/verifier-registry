() handle_deploy_operator(int value,slice body) impure method_id(148) {
 load_factory(); throw_unless(256,equal_slice_bits(message_sender,at(ownership,0)));
 body = body.skip_bits(32); int query = body~read_query_id(); int kind = body~read_kind(); slice beneficiary = body~load_msg_addr(); body.end_parse();
 cell state = operator_state(kind);
 int remaining = value - (storage_fees() + get_gas_fee(9959,0));
 (state,remaining,int mode,cell reply,cell address_state,int workchain) = funded_address_args(state,remaining,0,install_body(query,blank_code,operator_version,operator_code,begin_cell().store_slice(beneficiary)));
 send_prepared_deploy(state,remaining,mode,reply,address_state,workchain);
}

() handle_change_operator_user(int value,slice body) impure method_id(149) {
 load_factory(); throw_unless(256,equal_slice_bits(message_sender,at(ownership,0)));
 body = body.skip_bits(32); int query = body~read_query_id(); int kind = body~read_kind(); slice beneficiary = body~load_msg_addr(); body.end_parse();
 int remaining = value - (storage_fees() + get_gas_fee(9222,0));
 (beneficiary,remaining,kind,query) = beneficiary_send_fields(beneficiary,query,kind,remaining);
 int mode = evaluated(0); builder reply = beneficiary_body(query,beneficiary);
 slice destination = operator_address(kind); send_inline(mode,reply,remaining,destination);
}

