() deploy_vault(slice asset,int query,slice extra) impure method_id(137) {
 (int version,cell code,int found) = lookup_vault_code(vault_codes,asset.preload_uint(4)); throw_unless(260,found);
 cell state = vault_state(asset);
 send_deploy(64,state,install_body(query,blank_code,version,code,begin_cell().store_slice(extra)));
}

() handle_transfer_ownership (slice body) impure method_id(138) {
    load_factory();
    throw_unless(256, equal_slice_bits(message_sender, at(ownership, 0)));
