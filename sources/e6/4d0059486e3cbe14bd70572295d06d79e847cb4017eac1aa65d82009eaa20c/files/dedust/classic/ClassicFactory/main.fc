slice verify_vault_descriptor(cell descriptor) impure inline_ref {
 slice expected = state_address(proof_state(at(template_base,1),descriptor));
 slice cursor = descriptor.begin_parse(); slice factory = cursor~load_msg_addr(); int kind = cursor~read_kind();
 (cursor,slice asset) = read_asset(cursor); cursor.end_parse();
 throw_unless(264,((equal_slice_bits(message_sender,expected) & equal_slice_bits(at(template_base,0),factory)) & (kind == 1)));
 return asset;
}

cell deposit_state(slice owner,tuple assets) impure inline_ref {
 int kind = evaluated(3);
 builder params = begin_cell().store_slice(owner);
 (int stable,slice asset0,slice asset1) = unpack_triple(assets);
 cell config = params.store_uint(stable & 1,1).store_slice(asset0).store_slice(asset1).end_cell();
 return template_state(kind,begin_cell().store_ref(config));
}

() load_factory () impure inline_ref {
 slice data = get_data().begin_parse();
 slice owner = data~load_msg_addr(); slice pending = data~load_msg_addr();
 int unlock = data~read_unlock_time();
 (data,tuple saved_ownership) = ownership_record(owner,pending,data,unlock);
 ownership = saved_ownership;
 contract_version = data~read_version();
 blank_code = data~load_ref();
 template_base = opaque_tuple(pair(self_address(),blank_code));
 cell configuration = data~load_ref(); slice config = configuration.begin_parse();
 int pool_version = config~read_version(); cell pool_code = config~load_ref();
 pool_implementation = opaque_tuple(pair(pool_version,pool_code));
 int deposit_version = config~read_version(); cell deposit_code = config~load_ref();
 deposit_implementation = opaque_tuple(pair(deposit_version,deposit_code));
 vault_codes = config~load_dict(); lp_wallet_code = config~load_ref();
 if (data.slice_bits() > 0) {
  operator_version = data~read_version(); operator_code = data~load_dict();
 } else {
  operator_version = 0; operator_code = null();
 }
 config.end_parse(); data.end_parse();
}

() verify_operator(int kind) impure inline_ref {
 slice sender = evaluated_slice(message_sender);
 throw_unless(296,equal_slice_bits(sender,operator_address(kind)));
}

() save_factory () impure inline_ref {
    (slice element_0_00, slice element_1_00, int element_2_00) = unpack_triple(ownership);
    set_data(begin_cell()
        .store_slice(element_0_00)
        .store_slice(element_1_00)
        .store_unlock_time(element_2_00)
        .store_version(contract_version)
        .store_ref(blank_code)
        .store_ref(begin_cell()
            .store_version(at(pool_implementation,0))
            .store_ref(at(pool_implementation, 1))
            .store_version(at(deposit_implementation,0))
            .store_ref(at(deposit_implementation, 1))
            .store_maybe_ref(vault_codes)
            .store_ref(lp_wallet_code)
            .end_cell())
        .store_version(operator_version)
        .store_maybe_ref(operator_code)
        .end_cell());
    return ();
}

(int, cell, slice, tuple, int, int, int, slice, int, cell, cell) funding_fields (slice body) impure inline_ref {
