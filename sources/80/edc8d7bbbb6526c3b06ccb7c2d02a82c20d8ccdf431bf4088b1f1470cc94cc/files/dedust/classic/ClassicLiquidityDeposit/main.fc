;; Typed stack operations retain the old compiler ABI and validation order.
;; Lowercase nop emits no opcode. UNTUPLE checks remain observable.
forall TupleValue -> tuple opaque_tuple(TupleValue value) asm "nop";

forall TupleItem0, TupleItem1 -> (TupleItem0, TupleItem1) unpack_pair(tuple value) impure asm "2 UNTUPLE";
forall TupleItem0, TupleItem1, TupleItem2 -> (TupleItem0, TupleItem1, TupleItem2) unpack_triple(tuple value) impure asm "3 UNTUPLE";

