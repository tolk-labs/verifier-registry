            throw_unless(291,equal_slice_bits(vault_asset,a0) | equal_slice_bits(vault_asset,a1));
            int remaining = message_value - (storage_fees() + get_gas_fee(gas_consumed() + 3687,0));
            send_ref(0,join_body(query_id,vault_descriptor,owner,assets,minimum,target0,target1,vault_asset,amount,success,failure),remaining,at(template_base,0));
            return ();
        }
        throw(65535);
    } catch (_,int error) {
        set_actions(empty_actions());
        refund_notification(query_id,amount,owner);
        commit();throw(error);
    }
}

() handle_deposit_refund (int message_value, slice body) impure method_id(139) {
    load_vault();
    (slice after_query, int query_id) = body.skip_bits(32)
        .read_query_id();
    (slice after_config, cell config) = after_query.load_ref();
    (slice after_amount, int amount) = after_config.load_grams();
    (slice tail, cell payload) = after_amount.load_dict();
    tail.end_parse();
    (slice depositor, _) = verify_deposit_descriptor(config);
    int remaining = (message_value - (storage_fees() + get_gas_fee(9888, 0)));
    int forwarded = max((remaining - 50000000),0);
    send_ref(0,transfer_body(query_id,amount,depositor,depositor,forwarded,payload),remaining,jetton_wallet);
    return ();
}

