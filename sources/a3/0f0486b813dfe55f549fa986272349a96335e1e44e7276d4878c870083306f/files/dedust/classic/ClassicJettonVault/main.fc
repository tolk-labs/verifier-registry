    return (contract_version);
}

_ get_factory_address () impure method_id(89995) {
    load_vault();
    return (at(template_base, 0));
}

int get_join_budget (int body) impure method_id(109505) { return join_budget(body); }

() on_code_upgrade () impure method_id(43092) {
    return ();
