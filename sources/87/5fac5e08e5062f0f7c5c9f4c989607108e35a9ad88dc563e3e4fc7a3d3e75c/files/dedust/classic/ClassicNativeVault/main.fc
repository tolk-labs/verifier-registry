() on_code_upgrade () impure method_id(43092) {
    (slice probe, _) = get_data()
        .begin_parse()
        .load_msg_addr();
    if (probe.preload_uint(16) == 4) {
        (slice after_descriptor, cell descriptor) = get_data()
            .begin_parse()
            .load_ref();
        vault_descriptor = descriptor;
        (slice after_factory, slice factory) = after_descriptor.load_msg_addr();
        (slice after_blank, cell blank_code) = after_factory.load_ref();
        template_base = opaque_tuple(pair(factory, blank_code));
        (slice tail, int version) = after_blank.read_version();
        contract_version = version;
        tail.end_parse();
        locked_ton = 1792093259305502;
        save_vault();
    }
    return ();
}
