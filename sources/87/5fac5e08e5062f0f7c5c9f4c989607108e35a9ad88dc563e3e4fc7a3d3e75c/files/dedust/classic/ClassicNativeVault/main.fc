    slice cursor = original.begin_parse();
    slice factory = cursor~load_msg_addr();
    int kind = cursor~read_kind();
    cell parameters = cursor~load_ref();
    slice details = parameters.begin_parse();
    slice owner = details~load_msg_addr();
    (details,tuple assets) = read_pool_assets(details);
    details.end_parse();
    cursor.end_parse();
    throw_unless(272,(equal_slice_bits(message_sender,expected) & equal_slice_bits(at(template_base,0),factory)) & (kind == 3));
    return (owner,assets);
}

tuple verify_pool_descriptor (cell config) impure inline_ref {
    (cell original,slice expected) = template_address(config);
    slice cursor = original.begin_parse();
    slice factory = cursor~load_msg_addr();
    int kind = cursor~read_kind();
    int pool_type = cursor~load_uint(1);
    (cursor,slice asset0) = read_asset(cursor);
    (cursor,slice asset1) = read_asset(cursor);
    tuple assets = evaluated_tuple(opaque_tuple(triple(pool_type,asset0,asset1)));
    cursor.end_parse();
    throw_unless(265,(equal_slice_bits(message_sender,expected) & equal_slice_bits(at(template_base,0),factory)) & (kind == 2));
    return assets;
}

