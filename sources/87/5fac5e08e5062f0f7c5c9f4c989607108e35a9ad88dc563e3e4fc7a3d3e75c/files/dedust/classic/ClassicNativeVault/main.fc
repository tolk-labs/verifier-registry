    throw_unless(278, (route_depth < 5));
    int remaining = message_value - (storage_fees() + get_gas_fee(6481,0) + amount);
    locked_ton = (locked_ton + amount);
    save_vault();
    send_inline(0,swap_body(query_id,vault_descriptor,amount,message_sender,limit_kind,minimum,route,payload),remaining,pool);
    return ();
}

